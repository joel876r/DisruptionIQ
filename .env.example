# Sol / சொல் - Environment Variables Configuration
# Copy this file to .env and provide your actual API keys. Never commit .env!

# Google Gemini API Key (Required for reasoning engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated list for frontend access)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Gemini Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite
