# Zero-Bloat Repository .gitignore for Sol / சொல்
# Strict size constraint: Repository must stay under 10MB

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Python Caches & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Node & Frontend Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/dist
/dist-ssr
/build
*.local

# Editor & OS Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & Temporary Files
logs/
*.log
tmp/
temp/

# Strictly ignore binary media assets (Zero-bloat constraint: Use CSS/SVG only)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.mp3
*.wav
*.ogg
*.m4a
*.mp4
*.mov
*.avi
*.webm
*.zip
*.tar.gz
*.7z
